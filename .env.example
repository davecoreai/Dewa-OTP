# App
NEXT_PUBLIC_SITE_URL=https://dewaotp.my.id
NODE_ENV=development

# Supabase (gunakan Publishable/Anon Key di sini; jangan pernah expose Service Role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Nokos.co.id - server-side only
NOKOS_API_KEY=
# Generate a random secret (minimum 32 characters); configure the same value on Nokos webhook URL as ?key=...
NOKOS_WEBHOOK_SECRET=
NOKOS_BASE_URL=https://nokos.co.id/api/
# Markup jual DEWA OTP di atas harga provider. Contoh 20 = 20%.
PRICE_MARKUP_PERCENT=20

# Google reCAPTCHA v2 Checkbox
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# DOKU - server-side only (payment route masih fail-closed sampai adapter diverifikasi)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_WEBHOOK_SECRET=

# OpenRouter - server-side only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
