# App
NEXT_PUBLIC_SITE_URL=https://dewaotp.my.id
NODE_ENV=development

# Supabase: Publishable/Anon Key boleh berada di browser; Service Role hanya server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Nokosnesia REST API v1 — server-side only
# Buat API Key melalui Nokosnesia Dashboard -> API Keys.
NOKOSNESIA_API_KEY=
NOKOSNESIA_BASE_URL=https://nokosnesia.com/api/v1
# Samakan secret ini dengan Webhook Secret di dashboard Nokosnesia.
NOKOSNESIA_WEBHOOK_SECRET=
# Margin jual DEWA OTP di atas harga Nokosnesia, dalam persen.
PRICE_MARKUP_PERCENT=20

# Google reCAPTCHA v2 Checkbox
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# DOKU — integrasi deposit DEWA OTP masih fail-closed sampai adapter merchant diuji.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_WEBHOOK_SECRET=

# OpenRouter — server-side only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
